#!/bin/bash

# omarchy:summary=Install and configure Superwhisper dictation
# omarchy:requires-sudo=true

set -e

omarchy-pkg-add superwhisper-bin
bash /usr/share/superwhisper/setup-user
# Superwhisper requires a native recording shortcut; keep it separate from
# Omarchy's recording keys (Alt + Space and Right Alt).
superwhisper shortcuts set toggle "Ctrl+Alt+Space" >/dev/null
superwhisper shortcuts set hold none >/dev/null
omarchy-dictation-use superwhisper
omarchy-restart-hyprctl
omarchy-notification-send -g  "$(omarchy-i18n dictation.superwhisperReady)" "$(omarchy-i18n dictation.hint)" -t 10000
superwhisper settings
